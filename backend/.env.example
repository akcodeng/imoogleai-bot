# ============================================
# IMOOGLE 5.0 - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ============== CORE ==============
ENVIRONMENT=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
WEBHOOK_BASE_URL=https://your-domain.com
ADMIN_TOKEN=your_secure_admin_token
WEBAPP_URL=https://your-miniapp-url.com

# ============== DATABASE ==============
DATABASE_URL=postgresql://user:password@localhost:5432/imoogle
REDIS_URL=redis://localhost:6379

# ============== AI PROVIDERS ==============
# Primary: Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# Fast inference: Groq
GROQ_API_KEY=your_groq_api_key

# Cloudflare Workers AI (for Whisper STT)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Hume AI (for emotional AI)
HUME_API_KEY=your_hume_api_key

# ============== IMAGE GENERATION ==============
# Primary: Stability AI
STABILITY_API_KEY=your_stability_api_key

# Alternative: Leonardo AI
LEONARDO_API_KEY=your_leonardo_api_key

# Branding: Pictura AI
PICTURA_API_KEY=your_pictura_api_key

# ============== VOICE & TTS ==============
# ElevenLabs (for high-quality TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID_FEMALE=your_female_voice_id
ELEVENLABS_VOICE_ID_MALE=your_male_voice_id

# ============== SEARCH ==============
# Tavily (recommended)
TAVILY_API_KEY=your_tavily_api_key

# SearchNGX (alternative)
SEARCHNGX_API_KEY=your_searchngx_api_key

# ============== MEDIA APIs ==============
# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Genius (for lyrics)
GENIUS_API_KEY=your_genius_api_key

# TMDB (for movies)
TMDB_API_KEY=your_tmdb_api_key

# Google Books
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# ============== UTILITIES ==============
# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key

# IP Geolocation
IPINFO_TOKEN=your_ipinfo_token

# ============== PAYMENTS ==============
# Paystack (Nigeria)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_key

# KoraPay (Alternative)
KORAPAY_SECRET_KEY=your_korapay_secret_key
KORAPAY_PUBLIC_KEY=your_korapay_public_key

# ============== SENDPULSE ==============
SENDPULSE_API_USER_ID=your_sendpulse_user_id
SENDPULSE_API_SECRET=your_sendpulse_secret

# ============== RATE LIMITS ==============
RATE_LIMIT_MESSAGES=50
RATE_LIMIT_IMAGES=10
RATE_LIMIT_VOICE=20
RATE_LIMIT_WINDOW=3600
